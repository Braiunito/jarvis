#!/usr/bin/env python3
"""Hook de Claude Code que avisa a Jarvis cuando un Claude termina una tarea o pide permiso.

Se engancha en `~/.claude/settings.json` a dos eventos:

  · `Stop` — Claude terminó de responder: alerta `normal` con el título de la sesión y el final
    de lo que dijo.
  · `Notification` (permiso o pregunta) — Claude está parado esperándote: alerta `high` con lo
    que pide.

Lee del hook el JSON que manda Claude Code por la entrada estándar y delega el envío en
`jarvis-alert`, que sabe la URL y la clave (`~/.config/jarvis/alerts.env`).

Nunca estorba a Claude: no escribe nada en la salida estándar (en `Stop` eso podría leerse como
una orden), sale siempre con 0 y no espera más de 20 s. `JARVIS_ALERTS_HOOK=off` lo apaga, para
una sesión o un `claude -p` automatizado que no deba sonar.
"""
import json
import os
import shutil
import subprocess
import sys


def last_words(transcript_path: str) -> tuple[str | None, str | None]:
    """El título que Claude Code le puso a la sesión y el último texto de Claude, si se encuentran."""
    title, text = None, None
    try:
        with open(transcript_path, encoding="utf-8") as handle:
            lines = handle.readlines()[-400:]
    except OSError:
        return None, None
    for line in reversed(lines):
        try:
            entry = json.loads(line)
        except ValueError:
            continue
        if title is None and entry.get("type") == "ai-title":
            title = entry.get("aiTitle") or None
        message = entry.get("message") or {}
        if text is None and entry.get("type") == "assistant" and message.get("role") == "assistant":
            content = message.get("content")
            if isinstance(content, list):
                parts = [part.get("text", "") for part in content if part.get("type") == "text"]
                joined = "\n".join(p for p in parts if p).strip()
                if joined:
                    text = joined
        if title is not None and text is not None:
            break
    return title, text


def clip(value: str, limit: int) -> str:
    value = " ".join(value.split())
    return value if len(value) <= limit else value[: limit - 1] + "…"


def main() -> None:
    if os.environ.get("JARVIS_ALERTS_HOOK", "").lower() in ("off", "0", "false", "no"):
        return
    try:
        event = json.load(sys.stdin)
    except ValueError:
        return

    name = event.get("hook_event_name")
    folder = os.path.basename((event.get("cwd") or os.getcwd()).rstrip("/")) or "/"
    title, said = last_words(event.get("transcript_path") or "")
    what = clip(title, 90) if title else folder

    if name == "Stop":
        if event.get("stop_hook_active"):
            return
        importance = "normal"
        heading = f"Claude terminó: {what}"
        body = clip(said, 700) if said else "Terminó y espera tu siguiente mensaje."
    elif name == "Notification":
        kind = event.get("notification_type") or ""
        # El «lleva un rato esperando» llega después de cada Stop, que ya avisó: sería doble.
        if kind in ("idle_prompt", "auth_success"):
            return
        importance = "high"
        heading = f"Claude te necesita: {what}"
        body = clip(event.get("message") or "Está esperando tu permiso.", 700)
    else:
        return

    body = f"{body}\n\n📁 {event.get('cwd') or folder}"
    command = shutil.which("jarvis-alert") or os.path.expanduser("~/.local/bin/jarvis-alert")
    try:
        subprocess.run(
            [command, "-i", importance, "-a", "claude-code", heading[:200], body],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
            timeout=25, check=False,
            env={**os.environ, "CLAUDECODE": "1"},
        )
    except (OSError, subprocess.SubprocessError):
        pass


if __name__ == "__main__":
    try:
        main()
    except Exception:  # noqa: BLE001 — un aviso que falla no puede romper la sesión de nadie.
        pass
    sys.exit(0)
