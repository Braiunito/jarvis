#!/usr/bin/env bash
# Operación del stack. Todo lo que hace falta saber para levantar, mirar y parar esto.
#
# No presupone Node ni npm en la máquina: lo único que hace falta es Docker. El repositorio del
# bastión se actualiza con `git pull --ff-only` y después `bin/jarvis up`.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
compose_file="$here/deploy/compose.yml"
env_file="$here/deploy/.env"
overlay=()

# La superposición de LAN existe porque sin certificado no hay passkeys; se elige con JARVIS_MODE.
if [[ "${JARVIS_MODE:-}" == "lan" ]]; then
  overlay=(-f "$here/deploy/compose.lan.yml")
fi

# TLS real, pero terminado por un reverse proxy del host (nginx+certbot) en vez del Caddy propio.
if [[ "${JARVIS_MODE:-}" == "host-tls" ]]; then
  overlay=(-f "$here/deploy/compose.host-tls.yml")
fi

compose() {
  docker compose -f "$compose_file" "${overlay[@]}" --env-file "$env_file" "$@"
}

usage() {
  cat <<'TXT'
jarvis — operación del stack

  up            construye lo que haga falta y levanta todo
  down          para el stack (los volúmenes se quedan)
  restart <s>   reinicia un servicio
  logs [s]      sigue los registros
  ps            qué está corriendo y con qué salud
  smoke         comprueba que el stack responde de verdad
  backup [dir]  copia verificada de la base y del almacén de autenticación
  users ...     cuentas: add, enroll, list, disable, set-password…
  config        muestra la configuración efectiva de compose

  JARVIS_MODE=lan  usa la superposición de red local (sin TLS, sin passkeys)
TXT
}

case "${1:-}" in
  up)
    [[ -f "$env_file" ]] || { echo "falta deploy/.env — copia deploy/.env.example y rellénalo"; exit 1; }
    compose up -d --build
    echo
    compose ps
    ;;
  down)   compose down ;;
  restart) shift; compose restart "$@" ;;
  logs)   shift; compose logs -f --tail=100 "$@" ;;
  ps)     compose ps ;;
  config) compose config ;;
  smoke)
    shift
    compose exec -T gateway node -e "
      fetch('http://127.0.0.1:8080/healthz')
        .then(async (r) => { console.log('gateway', r.status, await r.text()); })
        .then(() => fetch('http://core:8770/internal/health'))
        .then(async (r) => { console.log('core   ', r.status, await r.text()); process.exit(r.ok ? 0 : 1); })
        .catch((e) => { console.error(e.message); process.exit(1); });
    "
    ;;
  backup)
    shift
    # La copia sale de dos contenedores porque el estado vive en dos sitios: la base la monta el
    # core y el almacén de autenticación lo monta el gateway, y ninguno ve la mitad del otro. Esa
    # separación es la frontera de privilegio del ADR-001 y no se rompe para hacer una copia: se
    # hace media en cada uno y se sacan las dos con `docker cp`.
    #
    # Aquí no hace falta Node ni saber en qué volumen vive nada, que es justo lo que antes hacía
    # imposible respaldar producción desde el bastión.
    dest="$here/backups/$(date -u +%Y-%m-%dT%H-%M-%SZ)"
    if [[ $# -gt 0 && "$1" != --* ]]; then dest="$1"; shift; fi
    inner="/tmp/jarvis-backup-$(date -u +%s)-$$"

    core_id="$(compose ps -q core || true)"
    gateway_id="$(compose ps -q gateway || true)"
    [[ -n "$core_id" ]] || { echo "el core no está levantado; arranca con 'bin/jarvis up' antes de copiar"; exit 1; }
    [[ -n "$gateway_id" ]] || { echo "el gateway no está levantado; arranca con 'bin/jarvis up' antes de copiar"; exit 1; }

    # Lo que queda dentro de los contenedores se va, salga bien o mal: son las claves del stack.
    limpiar() {
      docker exec "$core_id" rm -rf "$inner" >/dev/null 2>&1 || true
      docker exec "$gateway_id" rm -rf "$inner" >/dev/null 2>&1 || true
    }
    trap limpiar EXIT

    # La copia lleva `session.key`, `internal.key` y los hashes de contraseña: nace sin permisos
    # para nadie más que quien la hace.
    umask 077
    mkdir -p "$dest"

    compose exec -T core node /app/scripts/backup.mjs --only=core --out="$inner" "$@"
    compose exec -T gateway node /app/scripts/backup.mjs --only=auth --out="$inner" "$@"
    docker cp "$core_id:$inner/." "$dest/"
    docker cp "$gateway_id:$inner/." "$dest/"
    chmod -R go-rwx "$dest"

    # Media copia es un fallo, no un aviso: sin la base no hay nada que restaurar, y sin el
    # almacén de autenticación no entra nadie a mirarlo.
    [[ -s "$dest/core.db" ]] || { echo "la copia salió sin core.db; no la des por buena"; exit 1; }
    [[ -s "$dest/users.json" ]] || { echo "la copia salió sin users.json; no la des por buena"; exit 1; }

    echo
    echo "copia en $dest"
    ls -l "$dest"
    echo
    # Una copia que nunca se ha restaurado es una hipótesis. Estos pasos se ejecutan aquí mismo,
    # sin Node en el bastión, y sin pasear las claves del gateway por el core: se prueba con la
    # mitad de la base, que es la que puede estar corrupta sin que se note.
    echo "para comprobarla de verdad, restáurala en un destino vacío:"
    echo "  rm -rf /tmp/solo-core && mkdir /tmp/solo-core"
    echo "  cp $dest/core.db $dest/manifest-core.json /tmp/solo-core/"
    echo "  docker cp /tmp/solo-core $core_id:/tmp/solo-core"
    echo "  docker exec $core_id node /app/scripts/restore.mjs --from=/tmp/solo-core --core-db=/tmp/prueba/core.db --auth-dir=/tmp/prueba"
    echo "  docker exec $core_id rm -rf /tmp/solo-core /tmp/prueba && rm -rf /tmp/solo-core"
    ;;
  users)
    shift
    compose exec -T gateway node /app/apps/gateway/dist/bin/jarvis-users.js "$@"
    ;;
  *) usage ;;
esac
