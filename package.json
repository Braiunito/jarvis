{
  "name": "jarvis",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig.build.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:contracts": "vitest run --project contracts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "build": "npm run typecheck && npm run -w @jarvis/web build",
    "build:info": "node scripts/build-info.mjs",
    "dev:core": "node --experimental-strip-types apps/core/src/main.ts",
    "dev:gateway": "node --experimental-strip-types apps/gateway/src/main.ts",
    "dev:web": "npm run -w @jarvis/web dev",
    "check": "npm run typecheck && npm run lint && npm run test",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:user": "JARVIS_DATA_DIR=$PWD/.dev/gateway node apps/gateway/dist/bin/jarvis-users.js",
    "build:apps": "tsc -b tsconfig.build.json && npm run -w @jarvis/web build",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^3.2.7"
  }
}
