# Copiar a deploy/.env y rellenar. Este fichero de ejemplo se versiona; el .env nunca.

# --- borde -----------------------------------------------------------------
JARVIS_PUBLIC_HOST=jarvis.example.com
JARVIS_ACME_EMAIL=admin@example.com

# --- identidad -------------------------------------------------------------
# El dominio que ve el navegador. Una passkey enrolada bajo un rp id no vale bajo otro:
# cambiarlo invalida todas las credenciales existentes.
JARVIS_RP_ID=jarvis.example.com
JARVIS_ORIGINS=https://jarvis.example.com
JARVIS_AUTH_POLICY=passkey

# Secreto con el que el gateway firma la identidad interna que entrega al core.
# Distinto del de sesión a propósito. Generar con: openssl rand -base64 48
JARVIS_INTERNAL_SECRET=

# --- ESCOTILLA TEMPORAL: revisar en cada despliegue -------------------------
# Entrada por contraseña sobre HTTP plano. Existe sólo porque las passkeys son imposibles sin
# TLS. Apagarla en cuanto haya certificado.
JARVIS_INSECURE_LOGIN=false
JARVIS_INSECURE_LOGIN_LAN_ONLY=true
JARVIS_INSECURE_COOKIES=false

# --- flota -----------------------------------------------------------------
# Allowlist de hosts. Nunca vacía: es la diferencia entre una herramienta acotada y ejecución
# remota arbitraria.
JARVIS_HOSTS=bastion
JARVIS_BASTION_HOST=bastion
JARVIS_SSH_DIR=./secrets/ssh
# El spool vive en la MÁQUINA QUE EJECUTA, no en este contenedor: por eso va bajo el home del
# usuario remoto, que el core resuelve por host. Una ruta del sistema como /var/lib/... sólo
# funcionaría donde el agente entre como root.
#
# Con `~`, nunca con `$HOME`: Compose expande `$HOME` con el entorno del bastión antes de que el
# valor llegue al core, y entonces cada máquina de la flota intenta escribir en el home de otra.
JARVIS_SPOOL_ROOT=~/.local/state/jarvis/runs

# Perfil sin restricciones, apagado salvo que se entienda lo que implica.
JARVIS_ALLOW_YOLO=false

# --- cuánto se guarda de un trabajo viejo ----------------------------------
# Lo que pesa de un trabajo antiguo no es su historia —quién lo lanzó, dónde y cómo acabó— sino
# las salidas de herramienta y los volcados crudos. Pasados los primeros días se sustituyen por su
# huella y un resumen; pasado el mes queda el esqueleto. Los valores por defecto del core son
# éstos, así que descomentar sólo hace falta para cambiarlos.
#
# CUIDADO al estrenarlo sobre una base con historia: la primera pasada ocurre al arrancar y es
# irreversible. Conviene mirar antes cuántos trabajos caen dentro del corte.
#   JARVIS_EVENT_COMPACT_AFTER_DAYS=7
#   JARVIS_EVENT_DROP_AFTER_DAYS=30
#   JARVIS_EVENT_SUMMARY_CHARS=200
#   JARVIS_RETENTION_INTERVAL_MS=21600000

# --- ssh de la flota --------------------------------------------------------
# Dónde recuerda el core las claves de host que ya ha visto. Va al volumen de datos a propósito:
# en /tmp se vaciaba en cada arranque, y con StrictHostKeyChecking=accept-new eso significa
# aceptar a ciegas la primera clave que conteste, otra vez, en cada despliegue. Tampoco puede ir
# al ~/.ssh montado, que es de sólo lectura porque lleva la clave de la flota.
# El valor por defecto ya es el bueno; esto está aquí para que se sepa que existe.
#   JARVIS_KNOWN_HOSTS_FILE=/var/lib/jarvis-core/known_hosts

# --- límites del gateway ----------------------------------------------------
# Exigir Origin de la allowlist en el WebSocket de la terminal. Cierto por defecto: la política es
# web y un navegador manda la cabecera siempre. Ponerlo en false sólo si de verdad hay clientes
# que no son navegadores; no arregla ningún problema de la consola y abre la puerta a omitirlo.
#   JARVIS_REQUIRE_WS_ORIGIN=true
# Cuántos challenges de passkey pueden estar vivos a la vez. Emitirlos es barato para quien los
# pide y cuesta memoria a quien los guarda; el tope por IP es holgado para lo que hace una persona.
#   JARVIS_CHALLENGE_MAX_PER_IP=5
#   JARVIS_CHALLENGE_MAX_TOTAL=10000
#
# Y la limpieza de spools en las máquinas, que es otra cosa: eso borra directorios de trabajos
# terminados en cada host, no filas de la base.
#   JARVIS_SWEEP_INTERVAL_MS=21600000
#   JARVIS_SPOOL_RETENTION_DAYS=7

# --- índice ----------------------------------------------------------------
# El índice se construye desde el repositorio de aiSessions, que se espera vecino de éste.
# Cambia la ruta si lo tienes en otro sitio; deja la imagen si ya la construiste aparte.
# Dónde vive la clave de la flota. Las rutas relativas se resuelven contra ESTE directorio
# (deploy/), no contra la raíz del repositorio: en un despliegue de verdad conviene absoluta.
#   JARVIS_SSH_DIR=/home/zeus/jarvis/jarvis-next/secrets/ssh
JARVIS_SSH_DIR=../secrets/ssh

JARVIS_AISESSIONS_REPO=../../aisessions
# JARVIS_AISESSIONS_IMAGE=jarvis-aisessions:dev
# El home del usuario dentro de la imagen del índice, donde se monta la clave de la flota.
JARVIS_AISESSIONS_SSH_DIR=/home/jarvis/.ssh

# Usuario dueño de la clave SSH en el host. Los contenedores se construyen con estos ids para
# poder leer una clave 0600 sin aflojarle los permisos.
JARVIS_UID=1000
JARVIS_GID=1000

# --- Red local, mientras no haya certificado ---------------------------------
# Puerto del host donde escucha el gateway con la superposición `lan`. Es configurable para poder
# levantar este stack al lado de otro durante un corte.
JARVIS_LAN_BIND=127.0.0.1
JARVIS_LAN_PORT=8080
JARVIS_INDEX_TOKEN=
JARVIS_SYNC_INTERVAL=300

# --- Assistant -------------------------------------------------------------
# La credencial vive en el core: el navegador no la ve nunca.
JARVIS_MODEL_API_KEY=
JARVIS_MODEL_NAME=claude-sonnet-5
# Contra qué API habla. Si se deja vacío se deduce de la URL; conviene fijarlo cuando la
# credencial y el endpoint no sean del mismo proveedor que el valor por defecto.
#   anthropic → https://api.anthropic.com     openai → https://api.openai.com (o compatible)
JARVIS_MODEL_BASE_URL=https://api.anthropic.com
JARVIS_MODEL_PROVIDER=

# --- El asistente local y la puerta a la nube (ADR-009) ---------------------
#
# Con esto puesto, el asistente piensa en el `llama-server` del bastión y no cuesta un céntimo.
# La nube sigue estando, pero pasa a ser el sitio al que se **escala con permiso**: el modelo
# local lo pide, una persona lo firma, y sólo entonces sale algo de esta casa.
#
# La URL es la de la LAN y no 127.0.0.1: el core corre en un contenedor y ahí `localhost` es el
# contenedor. Por eso el servidor local escucha en la red y exige un bearer — la clave vive en
# `/home/zeus/llama-api.key` en el bastión, con permisos 600, y se copia aquí.
JARVIS_LOCAL_MODEL_BASE_URL=http://192.168.1.100:8181
JARVIS_LOCAL_MODEL_API_KEY=
JARVIS_LOCAL_MODEL_NAME=bartowski/Qwen_Qwen3-1.7B-GGUF:Q4_K_M
# Cuánto contexto sirve de verdad el modelo. Medido, no supuesto: `curl .../v1/models` lo dice en
# `meta.n_ctx`. Equivocarse aquí no degrada las respuestas, las impide.
JARVIS_LOCAL_MODEL_CONTEXT=16384
# Un modelo de casa a 7-10 tokens/s necesita más plazo que una API.
JARVIS_LOCAL_MODEL_TIMEOUT_MS=180000

# A dónde se escala. Si se dejan vacías, se usa el JARVIS_MODEL_* de arriba, que es lo que hace
# que una instalación existente no tenga que tocar nada.
#   JARVIS_CLOUD_MODEL_BASE_URL=https://api.openai.com
#   JARVIS_CLOUD_MODEL_API_KEY=
#   JARVIS_CLOUD_MODEL_NAME=gpt-5
#   JARVIS_CLOUD_MODEL_PROVIDER=openai

# --- Capacidades de sistema por MCP (ADR-009) ------------------------------
#
# Servidores MCP que el core CONSULTA. En esta casa es el MCP de sistema de Zeus: 108
# herramientas de diagnóstico del host, Docker, red, disco, la iGPU y las cámaras.
#
# El catálogo completo son 8294 tokens medidos, así que el asistente no lo ve entero: navega por
# áreas y busca. Por eso hay un lote de arranque, que es lo que lleva puesto sin buscarlo.
JARVIS_MCP_SERVERS=zeus=http://192.168.1.100:8765/mcp
# Si el servidor pide bearer. El de Zeus hoy NO tiene auth y está abierto a la LAN: eso es un
# riesgo conocido y anotado en su propio README, no un despiste de aquí.
JARVIS_MCP_TOKENS=

# QUIÉN PUEDE ESCRIBIR. Vacío significa que nadie, y ése es el valor correcto salvo que se
# entienda lo que implica: con `zeus` aquí, el asistente puede pedir permiso para reiniciar
# servicios y contenedores. Seguirá pidiéndolo siempre; lo que cambia es que ahora puede.
JARVIS_MCP_WRITE_SERVERS=

# Denegaciones propias. Se SUMAN a las de fábrica —reboot_server, poweroff_server, apt_install y
# apt_update_cache—, que no se sirven nunca porque no tienen vuelta atrás desde una conversación.
#   JARVIS_MCP_DENY=zeus.grep_text
#   JARVIS_MCP_ALLOW=
# El lote que el asistente lleva puesto. El valor por defecto del core ya es el bueno.
#   JARVIS_MCP_STARTER=zeus_playbook,system_health_snapshot,cpu_sampled,memory_pressure,camwall_overview

# Con cuánta cuerda nace una conversación. `manual` pregunta antes de cualquier efecto, incluido
# lanzar un trabajo en modo seguro; `auto` sólo suelta eso último. Se cambia desde la interfaz.
JARVIS_CHAT_DEFAULT_AUTONOMY=manual

# --- despliegue ------------------------------------------------------------
# En el corte se despliega por digest, no por tag móvil.
JARVIS_VERSION=dev
