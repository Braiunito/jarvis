# El borde. Única pieza con puertos publicados hacia fuera.
#
# TLS es un requisito del producto, no una mejora: sin contexto seguro el navegador no expone
# WebAuthn y las passkeys sencillamente no existen.
{
	email {$JARVIS_ACME_EMAIL:admin@example.com}
}

{$JARVIS_PUBLIC_HOST:localhost} {
	encode zstd gzip

	# Cabeceras de borde: las que no dependen del dominio ni de la aplicación.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	# El stream de eventos no puede quedarse en un búfer por el camino.
	@sse path /events/*
	reverse_proxy @sse gateway:8080 {
		flush_interval -1
	}

	reverse_proxy gateway:8080
}
